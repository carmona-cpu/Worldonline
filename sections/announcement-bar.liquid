{%- if section.settings.text != blank -%}
  <div class="announce" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis en pedidos de más de $150 · Devoluciones gratis por 30 días" },
    { "type": "url", "id": "link", "label": "Enlace (opcional)" }
  ],
  "presets": [{ "name": "Barra de anuncio" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
