{%- assign collection = section.settings.collection -%}
<section class="section" id="shop-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0, quick_add: section.settings.quick_add %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- liquid
            assign sample = i | plus: 2
          -%}
          {% render 'product-card', product: blank, index: forloop.index0, sample: sample %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Drop 04" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Novedades" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    { "type": "url", "id": "link", "label": "Enlace", "info": "Si lo dejas vacío lleva a la colección elegida." },
    { "type": "range", "id": "limit", "label": "Productos a mostrar", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Mostrar botón de agregar rápido", "default": true }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
