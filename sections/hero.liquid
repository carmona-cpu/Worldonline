<div class="hero" {{ section.shopify_attributes }}>
  {%- if section.settings.image != blank -%}
    {%- assign img_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', fetchpriority: 'high', alt: img_alt }}
  {%- else -%}
    <img src="{{ 'hero.webp' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1920" height="1088" fetchpriority="high">
  {%- endif -%}
  <div class="hero-copy">
    <div class="wrap rv">
      {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero-row">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn ghost" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Recomendado: 1920 × 1088 px o más. Sin imagen se usa la del diseño original." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Otoño / Invierno 26" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hecho pesado. Para diario." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Básicos de peso completo en algodón cepillado. Hechos para durar más que la moda." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Ver novedades" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button2_label", "label": "Botón secundario", "default": "Ver lookbook" },
    { "type": "url", "id": "button2_link", "label": "Enlace del botón secundario" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
