<section class="section look" id="look-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="strip">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
          assign fallback = 'look-' | append: forloop.index | append: '.webp'
        -%}
        <{{ tag }}{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign img_alt = block.settings.image.alt | default: block.settings.caption | escape -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 1000px) 20vw, 50vw', alt: img_alt }}
          {%- elsif forloop.index <= 5 -%}
            <img src="{{ fallback | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="800" height="1000">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption }}</span>{%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "@skystore" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Usado en la ciudad" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Etiquétanos para salir aquí" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "blocks": [
    {
      "type": "image", "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Formato vertical 4:5. Sin imagen se usa una foto del diseño original." },
        { "type": "text", "id": "caption", "label": "Texto sobre la foto" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "image", "settings": { "caption": "Look 01" } },
        { "type": "image", "settings": { "caption": "Look 02" } },
        { "type": "image", "settings": { "caption": "Look 03" } },
        { "type": "image", "settings": { "caption": "Look 04" } },
        { "type": "image", "settings": { "caption": "El estudio" } }
      ]
    }
  ]
}
{% endschema %}
