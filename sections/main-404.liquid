<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap center">
    <span class="label">404</span>
    <h1 style="font-size:clamp(32px,5vw,64px);line-height:1">{{ 'not_found.title' | t }}</h1>
    <p style="color:var(--ink-soft);margin:0">{{ 'not_found.text' | t }}</p>
    <a class="btn btn-dark" style="width:auto" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Página no encontrada",
  "settings": []
}
{% endschema %}
