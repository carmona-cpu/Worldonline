<div class="hero" style="min-height:100svh;display:grid" {{ section.shopify_attributes }}>
  <img src="{{ 'hero.webp' | asset_url }}" alt="" width="1920" height="1088" style="position:absolute;inset:0;height:100%">
  <div class="hero-copy" style="position:relative;align-self:end;background:linear-gradient(to top,rgba(20,14,10,.85),rgba(20,14,10,0))">
    <div class="wrap rv">
      <span class="label">{{ shop.name }}</span>
      <h1>{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

      {%- form 'customer', class: 'news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelanzamiento">
        <div class="news-row" style="max-width:420px">
          <label for="PwEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" style="color:var(--on-dark)">
          <button type="submit" style="color:var(--on-dark)">{{ 'password.notify' | t }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}

      <details style="color:var(--on-dark)">
        <summary class="label" style="cursor:pointer;color:var(--on-dark)">{{ 'password.owner' | t }}</summary>
        {%- form 'storefront_password' -%}
          <div class="news-row" style="max-width:420px;margin-top:12px">
            <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
            <input id="StorePassword" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password" style="flex:1;background:transparent;border:0;color:var(--on-dark);font:inherit;font-size:16px;padding:10px 0">
            <button type="submit" style="color:var(--on-dark);font-weight:600">{{ 'password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Página de contraseña",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Muy pronto." }
  ]
}
{% endschema %}
