{%- paginate search.results by 24 -%}
<section class="section" style="padding-top:clamp(32px,5vw,64px)" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if search.performed -%}
          <span class="label">{{ 'search.results_count' | t: count: search.results_count }}</span>
        {%- endif -%}
        <h1>{{ 'search.title' | t }}</h1>
      </div>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin-bottom:clamp(28px,4vw,48px)">
      <label for="SearchInput" class="visually-hidden">{{ 'search.title' | t }}</label>
      <input type="search" id="SearchInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="label" style="color:var(--ink)">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, index: forloop.index0, quick_add: true %}
            {%- else -%}
              <article class="card">
                <span class="label">{{ item.object_type }}</span>
                <b><a href="{{ item.url }}">{{ item.title }}</a></b>
                <p class="fit">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Búsqueda",
  "settings": []
}
{% endschema %}
