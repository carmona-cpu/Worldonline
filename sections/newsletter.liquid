<section class="section news" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div>
      {%- assign news_id = 'Newsletter-' | append: section.id -%}
      {%- form 'customer', id: news_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="news-row">
          <label for="NewsEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="NewsEmail-{{ section.id }}" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" value="{{ form.email }}">
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <div class="ok" role="status">{{ 'newsletter.success' | t }}</div>
        {%- elsif form.errors -%}
          <div class="ok" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boletín",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Entra primero al próximo drop." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Únete a la lista para acceso anticipado y 10% de descuento en tu primera compra." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Unirme" }
  ],
  "presets": [{ "name": "Boletín" }]
}
{% endschema %}
