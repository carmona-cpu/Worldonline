{%- comment -%}
  Productos recomendados por Shopify. Se cargan con JavaScript desde
  /recommendations/products (ver assets/skystore.js).
{%- endcomment -%}
<div
  class="product-recommendations"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
  {{ section.shopify_attributes }}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section">
      <div class="wrap">
        <div class="sec-head"><h2>{{ section.settings.heading }}</h2></div>
        <div class="grid">
          {%- for rec in recommendations.products -%}
            {% render 'product-card', product: rec, index: forloop.index0, quick_add: true %}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Recomendados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "También te puede gustar" },
    { "type": "range", "id": "limit", "label": "Productos a mostrar", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
