<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap values">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- if block.settings.label != blank -%}<span class="label">{{ block.settings.label }}</span>{%- endif -%}
        <h3>{{ block.settings.heading }}</h3>
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Valores de la marca",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "value", "name": "Valor",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Calidad" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Más pesada a propósito" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Telas gruesas que mantienen su forma lavada tras lavada." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valores de la marca",
      "blocks": [
        { "type": "value" },
        { "type": "value", "settings": { "label": "Hecho con cuidado", "heading": "Cortada y cosida con detalle", "text": "Cada pieza pasa por control de calidad antes de salir." } },
        { "type": "value", "settings": { "label": "30 días", "heading": "Devoluciones fáciles", "text": "¿No es tu talla? Devuélvela gratis dentro de 30 días." } }
      ]
    }
  ]
}
{% endschema %}
