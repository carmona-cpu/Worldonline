{%- comment -%}
  Barra de envío gratis, subtotal y botón de pago (checkout nativo de Shopify).
  El umbral se cambia en Configuración del tema > Carrito.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign left = threshold | minus: cart.total_price
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  <span class="label">
    {%- if left > 0 -%}
      {%- assign left_money = left | money -%}
      {{ 'cart.shipping_left' | t: amount: left_money }}
    {%- else -%}
      {{ 'cart.shipping_free' | t }}
    {%- endif -%}
  </span>
  <div class="ship"><i style="width:{{ pct }}%"></i></div>
{%- endif -%}
{%- for discount in cart.cart_level_discount_applications -%}
  <div class="total" style="font-weight:400"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
{%- endfor -%}
<div class="total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
<p class="tax-note">{{ 'cart.taxes_note' | t }}</p>
{%- if cart.item_count > 0 -%}
  <form action="{{ routes.cart_url }}" method="post" style="display:grid">
    <button type="submit" name="checkout" class="btn btn-dark">{{ 'cart.checkout' | t }}</button>
  </form>
{%- endif -%}
