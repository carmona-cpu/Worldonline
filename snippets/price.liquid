{%- comment -%}
  Precio de una variante. Parámetros: variant
{%- endcomment -%}
{{- variant.price | money -}}
{%- if variant.compare_at_price > variant.price -%}
  <s>{{ variant.compare_at_price | money }}</s>
{%- endif -%}
{%- if variant.unit_price_measurement -%}
  <small>{{ variant.unit_price | money }}/{{ variant.unit_price_measurement.reference_unit }}</small>
{%- endif -%}
